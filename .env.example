# ============================================================
# cls-etsy-automation — environment variable template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Etsy API ---
ETSY_API_KEY=your_etsy_api_key_here
ETSY_SHOP_ID=your_etsy_shop_id_here

# --- Reddit API (Trend Harvester) ---
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=trend_harvester/1.0

# --- Shipping / Fulfillment ---
SHIPPING_PROVIDER=usps
SHIPPING_API_KEY=your_shipping_api_key_here

# --- Sentiment Analysis ---
# leave blank to use default TextBlob engine
SENTIMENT_ENGINE=textblob

# --- Scheduler ---
# Cron-style schedule for each SOP (in minutes)
SOP1_INTERVAL_MINUTES=60
SOP2_INTERVAL_MINUTES=30
SOP3_INTERVAL_MINUTES=15
SOP4_INTERVAL_MINUTES=120
SOP5_INTERVAL_MINUTES=1440

# --- Paths ---
DATA_DIR=data
LOG_LEVEL=INFO
